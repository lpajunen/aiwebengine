# Local development environment.
#
# Used by `docker compose --env-file .env-local` and, for a host-side
# `cargo run`, by `source .env-local`. It is the one env file in the repository:
# its values are throwaway by design, so a local install starts without
# ceremony. Every other environment copies .env.example instead and fills in
# secrets of its own.
#
# Everything here overrides config.toml, which holds the defaults and the
# explanation of each setting.

# ---- compose: which file this is, and what Caddy serves --------------------
export ENV_FILE=.env-local
export SITE_HOSTS="localhost, 127.0.0.1, local.test"
export TLS_SNIPPET=tls_internal

# ---- what a developer wants to see -----------------------------------------
export RUST_LOG="info,aiwebengine=debug,sqlx=warn"
export APP_LOGGING__LEVEL=debug
export APP_LOGGING__FORMAT=pretty

# Short budgets for fast feedback, small ceilings for a laptop.
export APP_JAVASCRIPT__EXECUTION_TIMEOUT_MS=1000
export APP_JAVASCRIPT__MAX_MEMORY_BYTES=16777216
export APP_JAVASCRIPT__MAX_CONCURRENT_EXECUTIONS=50
export APP_REPOSITORY__MAX_CONNECTIONS=10

# Keep less of everything; a laptop database is not an archive.
export APP_LOGS__RETENTION_HOURS=24
export APP_LOGS__KEEP_PER_SCRIPT=100

# ---- database ---------------------------------------------------------------
# The host-side value, for `cargo run`, `cargo test` and the sqlx macros. The
# compose files set their own in `environment:`, which wins over this file,
# because the address of the database is a property of the topology rather than
# of the environment: inside the network it is postgres-dev, not localhost.
export APP_REPOSITORY__DATABASE_URL=postgresql://aiwebengine:devpassword@localhost:5432/aiwebengine
export DATABASE_URL=postgresql://aiwebengine:devpassword@localhost:5432/aiwebengine

# ---- throwaway secrets ------------------------------------------------------
# LOCAL DEVELOPMENT ONLY. These are published in this repository, so anyone can
# forge a session or read a secret encrypted with them. Generate your own for
# anything another person can reach: openssl rand -base64 32
#
# Each decodes to exactly 32 bytes, which the engine requires. The values that
# shipped in config.local.toml decoded to 37, 40 and 39, so a clone with no .env
# of its own could not start with authentication enabled — the container only
# ever worked because compose passed real keys from .env over the top.
export APP_AUTH__JWT_SECRET=local-install-jwt-secret-not-a-real-one
export APP_SECURITY__CSRF_KEY=bG9jYWwtZGV2ZWxvcG1lbnQtY3NyZi1rZXktLTMyYnk=
export APP_SECURITY__SESSION_ENCRYPTION_KEY=bG9jYWwtZGV2ZWxvcG1lbnQtc2Vzc2lvbi1rZXkzMmI=
export APP_SECURITY__SECRET_ENCRYPTION_KEY=bG9jYWwtZGV2ZWxvcG1lbnQtc2VjcmV0LWtleS0zMmI=
export APP_SECURITY__API_KEY=dev-api-key-12345

# ---- local security posture -------------------------------------------------
# Plain HTTP on localhost, so the cookie cannot be Secure. The engine drops the
# __Host- prefix to match, since a browser discards such a cookie over HTTP.
export APP_AUTH__COOKIE__SECURE=false
# Front ends served separately need naming; "*" would grant only
# unauthenticated reads, since a browser refuses a wildcard with credentials.
export APP_SECURITY__CORS_ALLOWED_ORIGINS='["http://localhost:3000","http://localhost:5173","https://localhost"]'
export APP_SECURITY__CONTENT_SECURITY_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"

# ---- who you are on a local install -----------------------------------------
# Internal accounts are the whole login story here: a local install has no
# public redirect URI, so no OAuth provider can be configured. Registration is
# open, so create "admin" once on the sign-in page and the engine is yours.
export APP_AUTH__INTERNAL__ENABLED=true
export APP_AUTH__INTERNAL__ALLOW_REGISTRATION=true
export APP_AUTH__INTERNAL__ALLOW_GUESTS=true
export APP_AUTH__INTERNAL__BOOTSTRAP_ADMIN_USERNAMES='["admin"]'
