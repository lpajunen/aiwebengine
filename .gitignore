/target
node_modules/
# config.toml is tracked: it is the one configuration file, and everything that
# differs between environments is an environment variable rather than a second
# copy of it. Editing it locally therefore shows up as a repository change,
# which is the point — that drift used to be invisible in an ignored file.
.env*
!.env.example
# Throwaway development values only, so a local install starts without ceremony.
!.env-local
.vscode/mcp.json
aiwebengine_latest.tar

# Caddy data (certificates and configuration)
caddy-data/
caddy-config/
caddy-logs/

# Logs
logs/
*.log

# Database files
data/
*.db
*.db-shm
*.db-wal

# Extra Caddy site blocks are per-deployment; only the example is tracked.
caddy-sites/*.caddy

# Dumps fetched off a deployment by `make docker-backup-fetch`. Never commit
# one: it holds every user, session and script in that environment, and the key
# that decrypts its secrets is one directory away in the env file.
backups/
