# Environment template for a server deployment (staging or production).
#
#   cp .env.example .env-production   # then fill in, then:
#   docker compose --env-file .env-production up -d
#
# One file per environment. config.toml holds the defaults and explains each
# setting; everything here overrides it. The naming rule is APP_ + section +
# __ + key, upper-cased, and a list is a JSON array in one variable.
#
# NEVER commit a filled-in copy. Only .env.example and .env-local are tracked,
# and .env-local contains nothing but throwaway development values.
#
# Check a filled-in file before deploying it:
#   set -a; . ./.env-production; set +a; aiwebengine --validate-config
#
# An empty value is not "unset" — it replaces what config.toml says. To keep a
# default, delete the line.

# =============================================================================
# REQUIRED — the engine refuses to start without these
# =============================================================================

# Signing key for sessions, minimum 32 characters.
#   openssl rand -base64 32
export APP_AUTH__JWT_SECRET=

# Encryption keys, each a base64-encoded 32 bytes.
#   openssl rand -base64 32
# SECRET_ENCRYPTION_KEY encrypts script and user secrets at rest: a database
# backup taken without it is one you cannot fully restore. Back all three up
# with the dump, and never rotate SECRET_ENCRYPTION_KEY casually — doing so
# makes every stored secret unreadable.
export APP_SECURITY__CSRF_KEY=
export APP_SECURITY__SESSION_ENCRYPTION_KEY=
export APP_SECURITY__SECRET_ENCRYPTION_KEY=

# Password for the bundled Postgres container. The compose file builds the
# engine's connection string from it, so this alone is enough when the database
# runs alongside. For a managed database, set APP_REPOSITORY__DATABASE_URL
# below instead and this is unused.
export POSTGRES_PASSWORD=

# =============================================================================
# HOSTNAMES — what this engine answers for
# =============================================================================

# The default host. Everything a script publishes lands here unless bound
# elsewhere in script_hosts.
export APP_SERVER__BASE_URL=https://example.com

# Additional hostnames served by the same engine. A login started on one of
# these completes there, so each entry's callback path must also be registered
# with every OAuth provider you configure.
export APP_SERVER__ADDITIONAL_BASE_URLS='["https://manage.example.com","https://world.example.com"]'

# Hosts allowed to serve /engine/* and the engine's own MCP tools. Everything
# else answers 404 there, so a script serving public content cannot drive the
# management API from a signed-in administrator's browser. Leave the line out
# to serve management on every host, which is what a single-host deployment
# wants.
export APP_SERVER__MANAGEMENT_HOSTS='["manage.example.com"]'

# Proxies whose X-Forwarded-For this engine believes. The Docker bridge range
# covers Caddy in the shipped compose stack. Without this every rate-limit
# bucket and session fingerprint is keyed by a header the caller wrote.
export APP_SERVER__TRUSTED_PROXIES='["172.16.0.0/12"]'

# =============================================================================
# DATABASE — only for a managed instance
# =============================================================================

# Leave this out when Postgres runs in the compose stack: the compose file sets
# it, and what it sets wins over this file. Set it for a managed database, and
# use sslmode=require. If a connection pooler sits in front, it must run in
# session pooling mode — transaction pooling breaks LISTEN/NOTIFY, and the
# symptom is not an error but stale caches on instances that never hear about a
# script write.
# export APP_REPOSITORY__DATABASE_URL=postgresql://user:pass@db.example.com:5432/aiwebengine?sslmode=require

# =============================================================================
# WHO ADMINISTERS THIS ENGINE
# =============================================================================

# Addresses that receive the administrator role on sign-in, matched against an
# address an OAuth provider verified. Needed at least once, to create the first
# administrator. The equivalent that needs no running server, only the database:
#   aiwebengine --grant-role <account> administrator
export APP_AUTH__BOOTSTRAP_ADMINS='["you@example.com"]'

# =============================================================================
# INTERNAL ACCOUNTS — off unless you turn them on
# =============================================================================

# Identities the engine authenticates itself: guests with no credential, and
# username/password accounts. All default to false in config.toml, so an
# environment that wants them must say so. Turn them on for solutions whose
# users should not hand a real-world identity to an OAuth provider, and for
# break-glass access when a provider is down or misconfigured.
#
# allow_registration is open sign-up: anybody who can reach the host can create
# an account. It lands in the authenticated tier, which touches no script, asset
# or schema, and it is recorded in the realm of the host it was created on.
export APP_AUTH__INTERNAL__ENABLED=true
export APP_AUTH__INTERNAL__ALLOW_REGISTRATION=false
export APP_AUTH__INTERNAL__ALLOW_GUESTS=false
# Local usernames holding the administrator role — the bootstrap_admins of an
# engine with no OAuth provider. Naming one is not a credential; reaching the
# account still takes its password.
# export APP_AUTH__INTERNAL__BOOTSTRAP_ADMIN_USERNAMES='["admin"]'

# =============================================================================
# OAUTH PROVIDERS — configured entirely here
# =============================================================================

# config.toml names no provider. A provider registers when its variables are
# present and does not exist when they are absent, so delete the block for any
# provider you do not use rather than leaving it empty — an empty value is a
# value, and it will be used.
#
# Every hostname that serves a login needs its own callback registered with the
# provider, e.g. both https://example.com/auth/callback/google and
# https://manage.example.com/auth/callback/google.
export APP_AUTH__PROVIDERS__GOOGLE__CLIENT_ID=
export APP_AUTH__PROVIDERS__GOOGLE__CLIENT_SECRET=
export APP_AUTH__PROVIDERS__GOOGLE__REDIRECT_URI=https://example.com/auth/callback/google

# export APP_AUTH__PROVIDERS__MICROSOFT__CLIENT_ID=
# export APP_AUTH__PROVIDERS__MICROSOFT__CLIENT_SECRET=
# export APP_AUTH__PROVIDERS__MICROSOFT__REDIRECT_URI=https://example.com/auth/callback/microsoft
# export APP_AUTH__PROVIDERS__MICROSOFT__TENANT_ID=common

# export APP_AUTH__PROVIDERS__APPLE__CLIENT_ID=
# export APP_AUTH__PROVIDERS__APPLE__CLIENT_SECRET=
# export APP_AUTH__PROVIDERS__APPLE__REDIRECT_URI=https://example.com/auth/callback/apple
# export APP_AUTH__PROVIDERS__APPLE__TEAM_ID=
# export APP_AUTH__PROVIDERS__APPLE__KEY_ID=

# =============================================================================
# OPTIONAL — config.toml's defaults are sensible; set these to differ
# =============================================================================

# Machine-to-machine API key.
# export APP_SECURITY__API_KEY=

# Origins allowed to read engine-owned responses. Empty (the default) is
# same-origin only. A named origin may send the session cookie; "*" may not.
# export APP_SECURITY__CORS_ALLOWED_ORIGINS='["https://app.example.com"]'

# Pin every session to the address it signed in from. Worth having only because
# TRUSTED_PROXIES establishes that address from the connection.
# export APP_SECURITY__STRICT_IP_VALIDATION=true

# export APP_LOGGING__LEVEL=info
# export APP_LOGS__RETENTION_HOURS=168
# export APP_LOGS__KEEP_PER_SCRIPT=1000
# export APP_REVISIONS__RETENTION_DAYS=30
# export APP_REVISIONS__KEEP_PER_SCRIPT=50
# export APP_JAVASCRIPT__EXECUTION_TIMEOUT_MS=10000
# export APP_JAVASCRIPT__MAX_CONCURRENT_EXECUTIONS=200
# export APP_REPOSITORY__MAX_CONNECTIONS=32

# Which env file the compose services load, and how many engine instances run.
# ENV_FILE must name this file; COMPOSE_PROFILES=ha adds the second instance.
export ENV_FILE=.env-production
# export COMPOSE_PROFILES=ha

# Container log filter.
export RUST_LOG=info
