# Caddyfile for aiwebengine production
# Handles HTTPS automatically with Let's Encrypt
#
# Three hostnames are served, all backed by the same engine cluster. Caddy
# passes the client's Host header through unchanged, so the engine can tell
# them apart via the Host header (see the host split notes at the bottom):
#
#   softagen.com         content served by ordinary solution scripts
#   world.softagen.com   content served by one designated script
#   manage.softagen.com  engine management APIs + management-only scripts
#
# The engine containers are only reachable on the internal Docker network,
# so a Host header arriving at the engine has necessarily been matched by
# one of the site blocks below and can be trusted.

# Shared upstream definition for the engine cluster.
(engine_upstream) {
	reverse_proxy aiwebengine-1:3000 aiwebengine-2:3000 {
		# Load balancing policy
		lb_policy round_robin

		# Health checks
		health_uri /health
		health_interval 10s
		health_timeout 5s
		health_status 2xx
	}
}

# Response headers shared by every host.
(common_headers) {
	header {
		# MIME sniffing protection
		X-Content-Type-Options "nosniff"
		# Referrer policy
		Referrer-Policy "strict-origin-when-cross-origin"
		# Remove Server header for security
		-Server

		# HSTS is deliberately not enabled yet. Turning it on with
		# includeSubDomains covers world./manage. too, and browsers cache
		# it for the full max-age, so enable it only once all three hosts
		# are known-good over HTTPS.
		# Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}

# Access logging shared by every host. The JSON format records request.host,
# so a single file still lets you separate traffic per hostname.
(common_log) {
	log {
		output file /var/log/caddy/access.log
		format json
	}
}

# Main production domain - content from ordinary solution scripts
softagen.com {
	import engine_upstream
	encode gzip
	import common_headers
	import common_log

	header {
		X-Frame-Options "SAMEORIGIN"
	}

	# The management API is refused on this host by the engine itself, via
	# server.management_hosts in config.production.toml — not here, because
	# /engine/installed has to stay reachable as the landing page for `/`
	# and a rule duplicated in both places would drift.
}

# Designated single-script host
world.softagen.com {
	import engine_upstream
	encode gzip
	import common_headers
	import common_log

	header {
		X-Frame-Options "SAMEORIGIN"
	}

	# As above, the management API is refused here by server.management_hosts.
}

# Management host - engine management APIs and management-only scripts
manage.softagen.com {
	import engine_upstream
	encode gzip
	import common_headers
	import common_log

	header {
		# Management UI must never be framed, not even by itself
		X-Frame-Options "DENY"
	}
}

# Redirect www to apex domain
www.softagen.com {
	redir https://softagen.com{uri} permanent
}

# Redirect test subdomain to main domain
test.softagen.com {
	redir https://softagen.com{uri} permanent
}
