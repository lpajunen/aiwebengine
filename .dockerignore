# Git
.git
.gitignore

# SQLx offline query metadata - MUST be included
!.sqlx/

# Node.js
node_modules/

# Documentation and markdown files
# *.md
# Neither stage copies these: nothing includes a file from docs/ at compile
# time, the routes that once served it are gone, and a release build of the lib
# and bin does not compile test targets.
docs/
tests/
archive/

# Rust build artifacts
target/
**/*.rs.bk
*.pdb

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Data and database files
data/
*.db
*.db-shm
*.db-wal

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD
.github/
.gitlab-ci.yml

# Environment files. The dash forms matter now that each environment has its
# own: `.env.*` never matched `.env-production`, so a filled-in file with real
# secrets would have been carried into the build context.
.env*

# Test artifacts
.coverage
htmlcov/

# Temporary files
tmp/
temp/
*.tmp

# Lock files (we copy these explicitly)
# Cargo.lock is needed for reproducible builds

# Configuration. config.toml is the one file and is copied into the image; the
# per-environment values are environment variables, and the env files carrying
# them are excluded above with .env*.
config.*.yaml

# Test fixtures. Only cfg(test) code includes these now, and the image builds
# neither the tests nor anything that reads them at runtime.
scripts/
# ...except the backup image's entrypoint. An exclusion is a property of the
# build *context*, not of a Dockerfile, and docker-compose.yml's `backup`
# service builds from this same context — so the one file it copies has to be
# named back in. Nothing in the engine image reads it.
!scripts/pg-backup.sh

# Makefile
Makefile

# Editor temporary files
.cargo/
.config/
