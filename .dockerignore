# Git
.git
.gitignore

# SQLx offline query metadata - MUST be included
!.sqlx/

# Node.js
node_modules/

# Documentation and markdown files
# *.md
# Neither stage copies these: nothing includes a file from docs/ at compile
# time, the routes that once served it are gone, and a release build of the lib
# and bin does not compile test targets.
docs/
tests/
archive/

# Rust build artifacts
target/
**/*.rs.bk
*.pdb

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Data and database files
data/
*.db
*.db-shm
*.db-wal

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD
.github/
.gitlab-ci.yml

# Environment files
.env
.env.*

# Test artifacts
.coverage
htmlcov/

# Temporary files
tmp/
temp/
*.tmp

# Lock files (we copy these explicitly)
# Cargo.lock is needed for reproducible builds

# Config files (we copy specific ones)
config.*.toml
config.*.yaml
!config.production.toml
!config.staging.toml
!config.local.toml

# Test fixtures. Only cfg(test) code includes these now, and the image builds
# neither the tests nor anything that reads them at runtime.
scripts/

# Makefile
Makefile

# Editor temporary files
.cargo/
.config/
