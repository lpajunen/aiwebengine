# Hostnames that only redirect somewhere else.
#
# Copy this to redirects.caddy and edit the names — literally, not through
# environment variables. A file in this directory belongs to one deployment, so
# there is nothing to parameterise, and a variable that expanded to nothing
# would take the whole configuration down with it: an empty site address fails
# with "server block without any key is global configuration".
#
# Each name listed here gets its own certificate, so list only names that
# actually resolve to this host.

www.example.com, test.example.com {
	redir https://example.com{uri} permanent
}
