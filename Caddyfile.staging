# Caddyfile for aiwebengine staging environment
# Handles HTTPS automatically with Let's Encrypt

# Staging domain (update with your actual staging domain)
staging.softagen.com {
    # Reverse proxy to aiwebengine container
    reverse_proxy aiwebengine:3000 {
        # Overwrite rather than append: Caddy adds the peer to whatever the
        # client sent, so an appended chain still starts with a value the
        # client wrote. The engine only reads this header from a proxy named
        # in server.trusted_proxies, and reads it right-to-left, but leaving
        # an invented chain in place serves no one.
        header_up X-Forwarded-For {remote_host}
    }
    
    # Enable gzip compression
    encode gzip
    
    # Security headers
    header {
        # Prevent clickjacking
        X-Frame-Options "SAMEORIGIN"
        # XSS protection
        X-Content-Type-Options "nosniff"
        # Referrer policy
        Referrer-Policy "strict-origin-when-cross-origin"
        # Remove Server header for security
        -Server
    }
    
    # Access logging
    log {
        output file /var/log/caddy/access.log
        format json
    }
}
